{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptEmbeddingLiveGateReport",
  "type": "object",
  "required": ["generated_at", "passed", "total_ms", "auth_failed_count", "checks"],
  "properties": {
    "generated_at": {"type": "string"},
    "passed": {"type": "boolean"},
    "total_ms": {"type": "integer", "minimum": 0},
    "auth_failed_count": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pass", "duration_ms", "auth_failed", "stderr_tail"],
        "properties": {
          "name": {"type": "string"},
          "pass": {"type": "boolean"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "auth_failed": {"type": "boolean"},
          "stderr_tail": {"type": "string"}
        }
      }
    }
  }
}
